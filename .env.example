# Database
DB_USER=postgres
DB_PASSWORD=12345
DB_HOST=postgres
DB_PORT=5432
DB_NAME=studnet

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO/S3
S3_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:9100
AWS_ACCESS_KEY=minioadmin
AWS_SECRET_KEY=minioadmin

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_here

# Email (Gmail)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
# Set to true in Docker/local dev to skip real SMTP (codes logged to backend console)
DISABLE_EMAIL=false
VERIFICATION_CODE_EXPIRE_MINUTES=15

# GitHub OAuth (optional)
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_SECRET=your_github_app_secret

# S3 Buckets
S3_AVATARS_BUCKET=avatars
S3_PROJECT_FILES_BUCKET=project-files
S3_MEDIA_BUCKET=media-bucket
S3_ANNOUNCEMENT_BUCKET=announcement-bucket
